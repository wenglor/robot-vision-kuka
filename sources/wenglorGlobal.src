GLOBAL DEFFCT FRAME read_pose_via_index(index:in)
   DECL INT index
   DECL INT last_index
   DECL CHAR command[200]
   DECL STATE_T string_status
   DECL INT str_sum
   
   $FLAG[42] = FALSE
   
   ; assemble command
   command[] = "pose:get["
   last_index = STRLEN(command[])
   SWRITE(command[], string_status, last_index, "%d" , index)
   str_sum = STRADD(command[], "];")
   
   ; send request to machine vision device
   g_eki_status = EKI_Send(g_connection_name[], command[])
   WAIT FOR $FLAG[42]
   
   ;error handling is done in function below
   RETURN read_pose_from_socket()
ENDFCT

