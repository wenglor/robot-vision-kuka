&ACCESS RV1
&REL 1
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF wenglorGlobal( )
   ;**************************************
   ;
   ; Module: wenglorGlobal
   ; Author: wenglor sensoric GmbH
   ; Version: 2.0.0
   ;
   ; Description:
   ;   The file manages all used functions.
   ;
   ;**************************************
END

GLOBAL DEF set_up_connection()
   ; set up socket connection
   g_eki_status = EKI_Init(g_connection_name[])
   ; connect with camera
   g_eki_status = EKI_Open(g_connection_name[])
   ; wait for connection to be established
   wait for $FLAG[1]
END

GLOBAL DEF close_connection()
   g_eki_status = EKI_Close(g_connection_name[])
   g_eki_status = EKI_Clear(g_connection_name[])
END

GLOBAL DEF update_sensor_state()
   DECL INT str_sum
   DECL CHAR raw_state[100]
   DECL INT i
   DECL BOOL clear_value
   
   ; assemble string, so the user only needs to update the use case and calibration target in the .dat file
   DECL CHAR command[100]
   command[] = "state["
   str_sum = STRADD(command[], g_use_case[])
   str_sum = STRADD(command[], "];")
   
   ; clear buffer to have a defined state
   FOR i=1 TO 100
      raw_state[i] = 0
   ENDFOR
   
   ; read state connection and calibration state from camera
   $FLAG[42] = FALSE
   g_eki_status = EKI_Send(g_connection_name[], command[])
   WAIT FOR $FLAG[42]
   g_eki_status = EKI_GetString(g_connection_name[], "sensor/reply/state", raw_state[])
   g_eki_status = EKI_ClearBuffer(g_connection_name[], "sensor")
   
   IF (raw_state[1] == "1") THEN
      g_camera_error = TRUE
      g_error_msg[] = "camera in connection error"
   ELSE
      ; reset error if there isn't any
      g_camera_error = FALSE
      clear_value = StrClear(g_error_msg[])
   ENDIF
   
   IF (raw_state[2] == "1") THEN
      g_calibration_done = TRUE
   ELSE
      g_calibration_done = FALSE
   ENDIF   
END

GLOBAL DEF calibrate_cam_to_rob()
   DECL REAL calib_accuracy
   ; necessary for user dialog to place calib board on object ground
   DECL KrlMsg_T calib_msg
   DECL KrlMsgPar_T parameter[3]
   DECL KrlMsgOpt_T options
   DECL INT msg_handle
   DECL INT i
   
   call_calibration_job()
   IF (g_camera_error) THEN
      RETURN
   ENDIF
   
   ; clear previous calibration
   send_simple_command("calibration:clear;")
   
   FOR i=1 to g_num_calibration_poses
      calibration_pose(i)
      add_calibration_pose()
      IF (g_camera_error) THEN
         RETURN
      ENDIF
   ENDFOR
   
   ; run first calibration step
   calib_accuracy = calibration_step_1()
   IF (g_camera_error) THEN
      RETURN
   ENDIF
   
   ; run second calibration step in case of camera not on robot
   IF (StrComp(g_use_case[], "camera_not_on_robot", #NOT_CASE_SENS)) THEN
      safety_pose()
      ; ask user to place the calibration plate and wait for confirmation
      calib_msg = {modul[] "wenglorMain", NR 1, MSG_TXT[] "Place calibration target at object ground and confirm this"}
      options = {vl_stop TRUE, clear_p_reset TRUE, clear_p_SAW TRUE, log_to_DB FALSE}
      msg_handle = SET_KRLMSG (#WAITING, calib_msg, parameter[], options)
      WHILE (EXISTS_KRLMSG(msg_handle))
         WAIT sec 0.1
      ENDWHILE
      calibration_step_2()
      IF (g_camera_error) THEN
         RETURN
      ENDIF
   ENDIF
   
   ; validate calibration
   validation()
END

DEF add_calibration_pose()
   DECL CHAR command[150]
   DECL CHAR robot_frame_char[100]
   DECL INT str_sum
   
   ; Wait time to ensure that the pose has been reached
   WAIT SEC 1
   robot_frame_char[] = get_rob_pos()
   command[] = "calibration:add[";
   str_sum = STRADD(command[], get_rob_pos())
   str_sum = STRADD(command[], "];")
   send_simple_command(command[]);
END

DEFFCT REAL calibration_step_1()
   DECL REAL reprojection_error
   DECL INT return_code
   DECL INT str_sum
   ; assemble string, so the user only needs to update the use case and calibration target in the .dat file
   DECL CHAR command[100]
   ; necessary for user dialog to wait for calculation
   DECL KrlMsg_T calc_msg
   DECL KrlMsgPar_T parameter[3]
   DECL KrlMsgOpt_T options
   DECL INT msg_handle
   DECL BOOL retVal
   
   command[] = "calibration:calculate["
   str_sum = STRADD(command[], g_use_case[])
   str_sum = STRADD(command[], ",")
   str_sum = STRADD(command[], g_calib_target[])
   str_sum = STRADD(command[], "];")
   
   $FLAG[42] = FALSE
   reprojection_error = 0.0
   return_code = 0
   
   g_eki_status = EKI_Send(g_connection_name[], command[])
   
   calc_msg = {modul[] "wenglorMain", NR 1, MSG_TXT[] "Calculation ongoing..."}
   options = {vl_stop TRUE, clear_p_reset TRUE, clear_p_SAW TRUE, log_to_DB FALSE}
   msg_handle = SET_KRLMSG (#WAITING, calc_msg, parameter[], options)
   
   WAIT FOR $FLAG[42]
   retVal = CLEAR_KRLMSG (msg_handle)
   
   g_eki_status = EKI_GetInt(g_connection_name[], "sensor/reply/return_code", return_code)
   g_eki_status = EKI_GetReal(g_connection_name[], "sensor/reply/calib_accuracy", reprojection_error)
   g_eki_status = EKI_ClearBuffer(g_connection_name[], "sensor")
   check_if_error(return_code)
   
   RETURN reprojection_error
ENDFCT

DEF calibration_step_2()
   DECL INT str_sum
   ; assemble string, so the user only needs to update the use case and calibration target in the .dat file
   DECL CHAR command[200]
   command[] = "calibration:ground["
   str_sum = STRADD(command[], g_calib_target[])
   str_sum = STRADD(command[], "];")
   send_simple_command(command[])
   RETURN
END

DEF validation()
   DECL KrlMsg_T validate_message
   DECL KrlMsgDlgSK_T validate_diag_keys[2]
   DECL KrlMsgPar_T validate_parameter[3]
   DECL KrlMsgOpt_T validation_options
   DECL INT validate_handle, keynumber
   
   validate_message = {modul[] "wenglorMain", NR 2, MSG_TXT[] "Run the verification?"}
   validate_diag_keys[1] = {sk_type #value, sk_txt[] "Yes"}
   validate_diag_keys[2] = {sk_type #value, sk_txt[] "No"}
   validation_options = {vl_stop TRUE, clear_p_reset TRUE, clear_p_SAW TRUE, log_to_DB FALSE}
   validate_handle = SET_KRLDLG(validate_message, validate_parameter[], validate_diag_keys[], validation_options)
   
   IF (validate_handle > 0) THEN
      WHILE (EXISTS_KRLDLG(validate_handle, keynumber))
         WAIT sec 0.1
      ENDWHILE
      
      SWITCH keynumber
         CASE 1
            validation_movement()
         CASE 2
            MsgNotify("Validation skipped.")
      ENDSWITCH
   ENDIF
   
   IF (g_camera_error) THEN
      RETURN
   ENDIF
END

GLOBAL DEFFCT FRAME get_validation_pose(safety_offset:in)
   DECL CHAR command[200]
   DECL INT str_sum
   DECL INT safety_offset
   DECL FRAME target_pose
   
   $FLAG[42] = FALSE
   
   ; assemble command
   command[] = "validate["
   str_sum = STRADD(command[], g_use_case[])
   str_sum = STRADD(command[], ",")
   str_sum = STRADD(command[], get_rob_pos())
   str_sum = STRADD(command[], "];")
   
   ; send request to machine vision device
   g_eki_status = EKI_Send(g_connection_name[], command[])
   WAIT FOR $FLAG[42]
   
   target_pose = read_pose_from_socket()
   target_pose.Z = target_pose.Z + safety_offset
   
   RETURN target_pose   
ENDFCT

GLOBAL DEF send_simple_command(command[]:IN)
   DECL CHAR command[]
   DECL INT return_code
   
   return_code = send_and_read_code(command[])
   check_if_error(return_code)
END

DEFFCT INT send_and_read_code(command[]:IN)
   DECL CHAR command[]
   DECL INT return_code
   $FLAG[42] = FALSE
   return_code = 0
   g_eki_status = EKI_Send(g_connection_name[], command[])
   WAIT FOR $FLAG[42]
   g_eki_status = EKI_GetInt(g_connection_name[], "sensor/reply/return_code", return_code)
   g_eki_status = EKI_ClearBuffer(g_connection_name[], "sensor")
   RETURN return_code
ENDFCT

DEF check_if_error(return_code:IN)
   DECL INT return_code
   DECL BOOL clear_ok
   
   IF (return_code < 0) THEN
      g_camera_error = TRUE
      set_return_error(return_code)
   ELSE
      g_camera_error = FALSE
      clear_ok = STRCLEAR(g_error_msg[])
   ENDIF
END

DEF set_return_error(error_code:IN)
   DECL INT error_code
   DECL INT error_code_abs
   DECL INT str_sum
   DECL CHAR error_message[100]
   
   error_code_abs=ABS(error_code);
   SWITCH error_code_abs
      CASE 5001
         g_error_msg[]="General Error";
      CASE 5002
         g_error_msg[]="Badly formatted request";
      CASE 5003
         g_error_msg[]="No connnection to univision";
      CASE 5004
         g_error_msg[]="Unknown univision job name";
      CASE 5005
         g_error_msg[]="Badly configured univision job";
      CASE 5006
         g_error_msg[]="Calibration failed";
      CASE 5007
         g_error_msg[]="No calibration data";
      CASE 5008
         g_error_msg[]="No object found";
      CASE 5009
         g_error_msg[]="Bad or empty device robot vision message";
      CASE 5010
         g_error_msg[]="Index error";
      DEFAULT
         g_error_msg[]="Unknown error code";
   ENDSWITCH
   
   ; Show error message to user
   str_sum = STRADD(error_message[], "Camera error: ")
   str_sum = STRADD(error_message[], g_error_msg[])
   MsgNotify(error_message[])
END

GLOBAL DEFFCT CHAR[200] read_current_job_name()
   DECL INT i
   DECL CHAR command[200]
   DECL INT return_code
   DECL CHAR job_name[200]
   
   ; clear buffer to have a defined state
   FOR i=1 TO 200
      job_name[i] = 0
   ENDFOR
   
   $FLAG[42] = FALSE
   return_code = 0
   
   command[] = "job:get;"
   
   g_eki_status = EKI_Send(g_connection_name[], command[])
   WAIT FOR $FLAG[42]
   g_eki_status = EKI_GetInt(g_connection_name[], "sensor/reply/return_code", return_code)
   g_eki_status = EKI_GetString(g_connection_name[], "sensor/reply/job_name", job_name[])
   g_eki_status = EKI_ClearBuffer(g_connection_name[], "sensor")
   
   check_if_error(return_code)
   IF (g_camera_error) THEN
      ; in case of error return "error", as it might be the least surprising value for an error case
      RETURN "error"
   ENDIF
   
   RETURN job_name[]
ENDFCT

GLOBAL DEFFCT FRAME detect_objects()
   DECL CHAR command[200]
   DECL INT str_sum
   
   $FLAG[42] = FALSE
   
   ; assemble command
   command[] = "detect["
   str_sum = STRADD(command[], g_use_case[])
   str_sum = STRADD(command[], ",")
   str_sum = STRADD(command[], get_rob_pos())
   str_sum = STRADD(command[], "];")
   
   ; send request to machine vision device
   g_eki_status = EKI_Send(g_connection_name[], command[])
   WAIT FOR $FLAG[42]
   
   RETURN read_pose_from_socket()   
ENDFCT

