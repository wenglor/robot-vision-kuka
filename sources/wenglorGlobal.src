DEFFCT CHAR[100] get_rob_pos()
   DECL E6POS tcp_pose_complete
   DECL FRAME tcp_pose
   DECL ROT_MAT rot_mat
   DECL ROT_VEC rot_vec
   
   tcp_pose_complete = $POS_ACT
   ; simplify to frame, as the robot vision server cannot handle external axis
   ; convert from mm to m
   tcp_pose.X = tcp_pose_complete.X / 1000
   tcp_pose.Y = tcp_pose_complete.Y / 1000
   tcp_pose.Z = tcp_pose_complete.Z / 1000
   
   ; convert rotation from euler with zyx order to rotation vector
   eulerzyx_to_rot_mat(tcp_pose_complete.A, tcp_pose_complete.B, tcp_pose_complete.C, rot_mat)
   rot_mat_to_rot_vec(rot_mat, rot_vec)
   
   tcp_pose.A = rot_vec.x
   tcp_pose.B = rot_vec.y
   tcp_pose.C = rot_vec.z
   
   RETURN frame_to_string(tcp_pose)
ENDFCT

DEFFCT FRAME read_pose_from_socket()
   DECL FRAME object_pose_raw
   DECL FRAME object_pose
   DECL REAL roll
   DECL REAL pitch
   DECL REAL yaw
   DECL ROT_VEC rot_vec
   DECL ROT_MAT rot_mat
   DECL INT return_code
   DECL FRAME error_frame
   DECL E6POS current_pose
   
   ; reset to have a defined state
   return_code = 0
   object_pose_raw.X = 0
   object_pose_raw.Y = 0
   object_pose_raw.Z = 0
   object_pose_raw.A = 0
   object_pose_raw.B = 0
   object_pose_raw.C = 0
   
   g_eki_status = EKI_GetInt(g_connection_name[], "sensor/reply/return_code", return_code)
   g_eki_status = EKI_GetReal(g_connection_name[], "sensor/reply/object_pose/@X", object_pose_raw.X)
   g_eki_status = EKI_GetReal(g_connection_name[], "sensor/reply/object_pose/@Y", object_pose_raw.Y)
   g_eki_status = EKI_GetReal(g_connection_name[], "sensor/reply/object_pose/@Z", object_pose_raw.Z)
   g_eki_status = EKI_GetReal(g_connection_name[], "sensor/reply/object_pose/@RX", object_pose_raw.C)
   g_eki_status = EKI_GetReal(g_connection_name[], "sensor/reply/object_pose/@RY", object_pose_raw.B)
   g_eki_status = EKI_GetReal(g_connection_name[], "sensor/reply/object_pose/@RZ", object_pose_raw.A)
   
   g_eki_status = EKI_ClearBuffer(g_connection_name[], "sensor")
   
   check_if_error(return_code)
   IF (g_camera_error) THEN
      ; in case of error return current pose
      current_pose = $POS_ACT
      error_frame.X = current_pose.X
      error_frame.Y = current_pose.Y
      error_frame.Z = current_pose.Z
      error_frame.A = current_pose.A
      error_frame.B = current_pose.B
      error_frame.C = current_pose.C
      RETURN error_frame
   ENDIF
   
   ; convert object pose from camera format to robot format
   rot_vec.x = object_pose_raw.C
   rot_vec.y = object_pose_raw.B
   rot_vec.z = object_pose_raw.A
   
   rot_vec_to_rot_mat(rot_vec,rot_mat)
   rot_mat_to_eulerzyx(rot_mat,yaw, pitch, roll)
   
   object_pose.X = object_pose_raw.X * 1000
   object_pose.Y = object_pose_raw.Y * 1000
   object_pose.Z = object_pose_raw.Z * 1000
   object_pose.A = yaw
   object_pose.B = pitch
   object_pose.C = roll
   
   RETURN object_pose
ENDFCT

DEFFCT REAL rad_to_deg(angle_rad:IN)
   DECL REAL angle_rad
   DECL REAL angle_deg
   angle_deg = angle_rad * 180/M_PI
   RETURN angle_deg
ENDFCT

DEFFCT REAL deg_to_rad(angle_deg:IN)
   DECL REAL angle_deg
   DECL REAL angle_rad
   angle_rad = angle_deg * M_PI/180
   RETURN angle_rad
ENDFCT

DEF rot_vec_to_rot_mat(rot_vec:IN, rot_mat:OUT)
   DECL ROT_VEC rot_vec
   DECL ROT_MAT rot_mat
   DECL REAL theta, sinTheta, cosTheta, oneMinusCosTheta
   DECL REAL vx, vy, vz
   
   ; convert radiant values to degrees, as geometric function of KUKA require it
   rot_vec.x = rad_to_deg(rot_vec.x)
   rot_vec.y = rad_to_deg(rot_vec.y)
   rot_vec.z = rad_to_deg(rot_vec.z)
   
   ; assume rotationVector is given with magnitude as the rotation angle
   theta = SQRT((rot_vec.x*rot_vec.x) + (rot_vec.y* rot_vec.y) + (rot_vec.z * rot_vec.z))
   vx = rot_vec.x / theta
   vy = rot_vec.y / theta
   vz = rot_vec.z / theta
   
   sinTheta = SIN(theta)
   cosTheta = COS(theta)
   oneMinusCosTheta = 1 - cosTheta
   
   ; manually compute each element of the rotation matrix
   rot_mat.m_1_1 = cosTheta + vx*vx*oneMinusCosTheta
   rot_mat.m_1_2 = vx*vy*oneMinusCosTheta - vz*sinTheta
   rot_mat.m_1_3 = vx*vz*oneMinusCosTheta + vy*sinTheta
   rot_mat.m_2_1 = vy*vx*oneMinusCosTheta + vz*sinTheta
   rot_mat.m_2_2 = cosTheta + vy*vy*oneMinusCosTheta
   rot_mat.m_2_3 = vy*vz*oneMinusCosTheta - vx*sinTheta
   rot_mat.m_3_1 = vz*vx*oneMinusCosTheta - vy*sinTheta
   rot_mat.m_3_2 = vz*vy*oneMinusCosTheta + vx*sinTheta
   rot_mat.m_3_3 = cosTheta + vz*vz*oneMinusCosTheta
   
END

DEF rot_mat_to_eulerzyx(rot_mat:IN, yaw:OUT, pitch:OUT, roll:OUT)
   DECL ROT_MAT rot_mat
   DECL REAL roll, pitch, yaw
   
   ; calculate pitch
   pitch = ATAN2(-rot_mat.m_3_1, SQRT((rot_mat.m_1_1 * rot_mat.m_1_1) + (rot_mat.m_2_1 * rot_mat.m_2_1)))
   
   ; calculate yaw
   yaw = ATAN2(rot_mat.m_2_1, rot_mat.m_1_1)
   
   ; calculate roll
   roll = ATAN2(rot_mat.m_3_2, rot_mat.m_3_3)
END

DEF eulerzyx_to_rot_mat(yaw:IN, pitch:IN, roll:IN, rot_mat:OUT)
   DECL REAL yaw
   DECL REAL roll
   DECL REAL pitch
   
   DECL ROT_MAT rot_mat
   
   DECL REAL cos_roll
   DECL REAL sin_roll
   DECL REAL cos_pitch
   DECL REAL sin_pitch
   DECL REAL cos_yaw
   DECL REAL sin_yaw
   
   ; degrees, as SIN and COS require it
   cos_yaw = COS(yaw)
   sin_yaw = SIN(yaw)
   cos_pitch = COS(pitch)
   sin_pitch = SIN(pitch)
   cos_roll = COS(roll)
   sin_roll = SIN(roll)
   
   ; construct the rotation matrix R = Rz(yaw) * Ry(pitch) * Rx(roll)
   rot_mat.m_1_1 = cos_yaw * cos_pitch
   rot_mat.m_1_2 = (cos_yaw * sin_pitch * sin_roll) - (sin_yaw * cos_roll)
   rot_mat.m_1_3 = (cos_yaw * sin_pitch * cos_roll) + (sin_yaw * sin_roll)
   rot_mat.m_2_1 = sin_yaw * cos_pitch
   rot_mat.m_2_2 = (sin_yaw * sin_pitch * sin_roll) + (cos_yaw * cos_roll)
   rot_mat.m_2_3 = (sin_yaw * sin_pitch * cos_roll) - (cos_yaw * sin_roll)
   rot_mat.m_3_1 = -sin_pitch
   rot_mat.m_3_2 = cos_pitch * sin_roll
   rot_mat.m_3_3 = cos_pitch * cos_roll
END

DEF rot_mat_to_rot_vec(rot_mat:IN, rot_vec:OUT)
   DECL ROT_MAT rot_mat
   DECL REAL angle
   DECL REAL axis_components[3]
   DECL ROT_VEC rot_vec
   
   ; calculate the angle value of rotation, ACOS returns values in degrees
   angle = ACOS((rot_mat.m_1_1 +rot_mat.m_2_2 + rot_mat.m_3_3 -1)/2)
   
   ; calculate the axis components
   axis_components[1] = (rot_mat.m_3_2 - rot_mat.m_2_3) / (2 * SIN(angle))
   axis_components[2] = (rot_mat.m_1_3 - rot_mat.m_3_1) / (2 * SIN(angle))
   axis_components[3] = (rot_mat.m_2_1 - rot_mat.m_1_2) / (2 * SIN(angle))
   
   ; convert to radiant as camera requires radiant values
   angle = deg_to_rad(angle)
   
   ; calculate the rotation vector
   rot_vec.x = axis_components[1] * angle
   rot_vec.y = axis_components[2] * angle
   rot_vec.z = axis_components[3] * angle
END

DEF append_real_to_string(value:IN, add_comma:IN, string[]:OUT)
   DECL REAL value
   DECL BOOL add_comma
   DECL INT last_index
   DECL INT str_add_rtn
   DECL STATE_T string_status
   DECL CHAR string[]
   
   last_index = STRLEN(string[])
   SWRITE(string[], string_status, last_index, "%.6f" , value)
   IF add_comma == TRUE THEN
      str_add_rtn = STRADD(string[], ",")
   ENDIF
END

DEFFCT CHAR[100] frame_to_string(tcp_frame:IN)
   DECL FRAME tcp_frame
   DECL CHAR tcp_pose_string[100]
   DECL INT str_sum
   
   str_sum = STRADD(tcp_pose_string[], "[")
   append_real_to_string(tcp_frame.X, TRUE, tcp_pose_string[])
   append_real_to_string(tcp_frame.Y, TRUE, tcp_pose_string[])
   append_real_to_string(tcp_frame.Z, TRUE, tcp_pose_string[])
   append_real_to_string(tcp_frame.A, TRUE, tcp_pose_string[])
   append_real_to_string(tcp_frame.B, TRUE, tcp_pose_string[])
   append_real_to_string(tcp_frame.C, FALSE, tcp_pose_string[])
   str_sum = STRADD(tcp_pose_string[], "]")
   RETURN tcp_pose_string[]
ENDFCT